version 1
name "Level"
(array)entities {
    - name="Lighting" prototype="Lighting"
    - name="Backdrop" prototype="Backdrop"
    - {
        name "Player"
        prototype "Player"
        components {
            Transform x=20.0 y=152.0
        }
    }
    - {
        name "Camera"
        prototype "Camera"
        components {
            Transform x=160.0 y=94.0
        }
    }
    - name="Room" prototype="Room"
}
