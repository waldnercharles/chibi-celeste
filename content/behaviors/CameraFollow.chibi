// Celeste's camera: centre on the player, clamp to the room, ease in.
behavior CameraFollow {
    player: entity
    level: entity
    on Begin {
        player = globals.Player
        level = globals.Level
        self.Transform = Target()
    }

    function Target() {
        width := level.Tilemap.Columns * level.Tilemap.FrameWidth
        height := level.Tilemap.Rows * level.Tilemap.FrameHeight
        origin := level.Transform
        at := player.Transform - origin
        return origin + vec2(clamp(at.x, 160, width - 160), clamp(at.y, 90, height - 90))
    }

    on Tick {
        self.Transform += (Target() - self.Transform) * (1 - pow(0.01, dt))
    }
}
